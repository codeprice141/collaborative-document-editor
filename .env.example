# ==============================================================================
# Collaborative Document Editor - Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Settings
PROJECT_NAME="Collaborative Document Editor"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=collaborative_editor
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collaborative_editor
